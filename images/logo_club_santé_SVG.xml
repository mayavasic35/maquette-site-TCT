<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="500" viewBox="0 0 1200 500">
  <rect width="1200" height="500" fill="white"/>

  <!-- Couleurs -->
  <defs>
    <style>
      .orange { fill: #d85a24; }
      .gray { fill: #8a8f94; }
      .white { fill: #ffffff; }
      .font-main {
        font-family: Arial, Helvetica, sans-serif;
        font-weight: 800;
        letter-spacing: 2px;
      }
      .font-small {
        font-family: Arial, Helvetica, sans-serif;
        font-weight: 700;
        letter-spacing: 3px;
      }
    </style>
  </defs>

  <!-- Bloc orange gauche -->
  <rect x="60" y="55" width="265" height="390" class="orange"/>

  <!-- Petit trait blanc haut -->
  <rect x="182" y="55" width="18" height="28" class="white"/>

  <!-- Texte TEN -->
  <text x="96" y="175" font-size="93" class="white font-main">TEN</text>

  <!-- Fédération Française -->
  <text x="92" y="235" font-size="21" class="white font-small">FÉDÉRATION</text>
  <text x="92" y="267" font-size="21" class="white font-small">FRANÇAISE</text>

  <!-- Texte NIS -->
  <text x="96" y="382" font-size="93" class="white font-main">NIS</text>

  <!-- Texte principal gris -->
  <text x="395" y="173" font-size="100" class="gray font-main">CLUB</text>
  <text x="395" y="285" font-size="100" class="gray font-main">TENNIS</text>
  <text x="395" y="397" font-size="100" class="gray font-main">SANTÉ</text>

  <!-- Crochet orange droit -->
  <rect x="1045" y="55" width="95" height="20" class="orange"/>
  <rect x="1120" y="55" width="20" height="390" class="orange"/>
  <rect x="1045" y="425" width="95" height="20" class="orange"/>
</svg>
